###Template
# Local Postgres container (used by docker-compose). POSTGRES_PORT is the host
# port; leave empty to use 5432. POSTGRES_USER/PASSWORD/DB must match DB_USERNAME/
# DB_PASSWORD and the DB name in DB_URL when running against this container.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=
# Spring datasource (used when running outside docker, e.g. IDE / remote DB)
DB_URL=
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=
JWT_ACCESS_EXPIRATION=
JWT_REFRESH_EXPIRATION=
# Local credentials for the seeded dev accounts (DatabaseSeeder). Leave a pair
# empty and that account is seeded OAuth-only, with no password.
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
SEED_COUNSELOR_USERNAME=
SEED_COUNSELOR_PASSWORD=
SEED_STUDENT_USERNAME=
SEED_STUDENT_PASSWORD=
GOOGLE_EMAIL_USERNAME=
GOOGLE_EMAIL_PASSWORD=
CLIENT_ID_GOOGLE=
CLIENT_SECRET_GOOGLE=
CLIENT_ID_GITHUB=
CLIENT_SECRET_GITHUB=
AUTHORIZED_REDIRECT_URI=
SCRAPER_API=
SCRAPER_PROXY=
AI_SERVICE_BASE_URL=
AI_SERVICE_URL=
AI_SERVICE_API_KEY=
MCP_DOCUMENT_SERVICE_ENABLED=
MCP_DOCUMENT_SERVICE_URL=
MCP_DOCUMENT_SERVICE_TIMEOUT=
